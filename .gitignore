avator.jpeg

# 构建期生成:全文搜索索引、iOS 图标
public/search-index.json
public/apple-touch-icon.png

# 图片管线产物 —— 原图入库,webp 变体与清单每次构建重新生成
public/images/**/*.webp
public/images/images.manifest.json

# 本地环境变量(API key 之类),绝不入库
.env
.env.local

# 本地 agent 配置(AGENTS.md / mcp.json 等,只在本机用,不进仓库)
.omp
